# Copy to .env.local and fill in. Never commit .env.local.

# Demo mode: run the whole app without Clerk or Supabase (no sign-in; data in .unfold-demo.json).
# Great for working on the UI. Leave unset (or false) in production.
# NEXT_PUBLIC_DEMO_MODE=true

# Domain that serves the marketing site and app. Portfolios live on subdomains of it.
# Local development: localhost:3000 (portfolios at http://<slug>.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (project settings → API). The publishable key is safe in the browser;
# row-level security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI for reading resumes and drafting case studies (server only). Set ONE of these.
#
# Google Gemini (aistudio.google.com → Get API key). Free tier on Flash models; reads PDFs directly.
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
#
# Or OpenRouter (openrouter.ai → Keys). "openrouter/free" picks a free model per request.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
#
# Or Claude (console.anthropic.com). Paid per use, reads PDFs directly, most reliable.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# If several keys are set: Gemini, then OpenRouter, then Claude. AI_PROVIDER=gemini|openrouter|anthropic forces one.

# GitHub import (optional). Without a token GitHub allows 60 requests an hour per server IP.
# A fine-grained token with no extra permissions is enough for public repositories.
# GITHUB_TOKEN=github_pat_...

# Contact form: secret salt for hashing sender IPs (used only for rate limits). Any long random string.
# CONTACT_HASH_SALT=change-me-to-a-long-random-string

# ---------- Production (all optional; each feature stays off until its keys are set) ----------
# Supabase secret (service role) key: custom domains, the admin page and email alerts. Server only, never NEXT_PUBLIC.
# SUPABASE_SECRET_KEY=sb_secret_...

# Email alerts for contact-form messages (resend.com). EMAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Unfold <hello@yourdomain.com>"

# Let users connect their own domains automatically (Vercel → Account Settings → Tokens; Project → Settings → General).
# VERCEL_TOKEN=...
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...        # only for team projects

# Clerk user ids allowed to open /admin, comma separated (Clerk dashboard → Users → copy User ID).
# ADMIN_USER_IDS=user_abc,user_def

# Address shown on the privacy and terms pages and in the footer.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Post uncaught server errors to a Slack or Discord webhook.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
